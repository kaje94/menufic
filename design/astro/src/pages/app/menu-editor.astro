---
import AppShell from '../../layouts/AppShell.astro';
import DishRow, { dishRowStyles } from '../../components/app/DishRow.tsx';
import { dishes } from '../../data/dishes';

// Migrated from design/landing/app/menu-editor.html (~1070 lines). The app
// shell (topbar/sidebar/drawer/scripts) is owned by AppShell.astro — only the
// <main> editor content lives here. The dish `.item` row (grip / thumb /
// name+desc / price / availability segment / edit+delete) is the co-located
// DishRow island, which also owns the shared .grip/.rbtn/.seg primitive CSS.
// This page's <style> owns the editor layout, menu-list panel, ghost-add
// buttons and the item edit panel.
//
// INTERACTIVITY DECISIONS (prototype fidelity — static where the source's
// initial DOM is static; matches restaurant.astro's dead-action precedent):
//   - Availability segments render statically from d.availability (no live
//     toggle — per the task brief).
//   - Menu selector (Dinner selected), grips, per-row edit/delete, "Add
//     item/menu/category", Preview/Publish are static affordances (#/type=button).
//   - The item edit panel is ported in its closed initial state (the source's
//     initial DOM). It never opens in the static prototype, so its form
//     controls (name/desc/price/upload/status segment/tags/save/cancel) are
//     static; it is display:none while closed so the fixed off-canvas panel
//     cannot add horizontal overflow. Sidebar drawer + account menu + Escape
//     are handled by AppShell's own islands.
//
// The source <main> is left-aligned (max-w-[1320px], NO mx-auto) — matched.

// Source category grouping of the Dinner menu (Mains / Small plates / Sides).
const byId = (id: string) => dishes.find((d) => d.id === id)!;
const categories = [
  { name: 'Mains', items: ['smoked-short-rib', 'wood-fired-margherita', 'saffron-prawns'].map(byId) },
  { name: 'Small plates', items: ['red-shrimp-broth', 'charred-sharing-board'].map(byId) },
  { name: 'Sides', items: ['burnt-honey-carrots', 'sourdough-cultured-butter'].map(byId) },
];
---
<AppShell crumb="Saffron & Smoke" currentRestaurantId="saffron-smoke" currentSection="/app/menu-editor">
  <main class="w-full max-w-[1320px] px-[clamp(1rem,3vw,2.5rem)] pb-20 pt-[clamp(1.5rem,4vw,2.75rem)]">

    <!-- Page head -->
    <div class="mb-[clamp(20px,2.6vw,30px)] flex flex-wrap items-end justify-between gap-6">
      <div class="min-w-0">
        <h1 class="stagger text-[clamp(2rem,4.1vw,2.9rem)] tracking-[-0.035em]" data-delay="0">
          Menu editor <em class="not-italic text-secondary">·</em> Saffron &amp; Smoke
        </h1>
        <p class="stagger mt-2.5 max-w-[56ch] text-[clamp(0.98rem,1.4vw,1.08rem)] leading-[1.5] text-base-content/70" data-delay="0">
          Drag to reorder, set what's available tonight, and tune prices and photos. Changes preview live before you publish.
        </p>
      </div>
      <div class="stagger flex flex-wrap gap-3" data-delay="1">
        <a class="btn btn-ghost" href="/public">
          <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          Preview
        </a>
        <a class="btn btn-primary" href="#">
          <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg>
          Publish menu
        </a>
      </div>
    </div>

    <!-- Two-column editor -->
    <div class="editor">

      <!-- ===== LEFT: menu list panel ===== -->
      <aside class="menu-panel-sticky stagger sticky top-[80px] rounded-3xl border border-base-content/[.28] bg-base-200 p-4" data-delay="2" aria-label="Menus">
        <div class="flex items-center justify-between px-1.5 pb-3 pt-1">
          <h2 class="font-display font-semibold tracking-tight" style="font-size:1.18rem;letter-spacing:-0.02em">Menus</h2>
          <span class="rounded-full border border-base-content/[.28] bg-base-100 px-2.5 py-px text-[11px] font-semibold text-base-content/70">3</span>
        </div>
        <div class="menu-list" role="list">
          <div class="menu-row" role="listitem">
            <button class="grip" type="button" aria-label="Drag to reorder Breakfast menu"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="6" r="1.4"/><circle cx="15" cy="6" r="1.4"/><circle cx="9" cy="12" r="1.4"/><circle cx="15" cy="12" r="1.4"/><circle cx="9" cy="18" r="1.4"/><circle cx="15" cy="18" r="1.4"/></svg></button>
            <button class="mr-pick" type="button" data-menu="breakfast" aria-pressed="false">
              <span class="v-dot" aria-hidden="true"></span>
              <span class="v-name">Breakfast</span>
              <span class="v-time">7–11am</span>
            </button>
          </div>
          <div class="menu-row" role="listitem">
            <button class="grip" type="button" aria-label="Drag to reorder Lunch menu"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="6" r="1.4"/><circle cx="15" cy="6" r="1.4"/><circle cx="9" cy="12" r="1.4"/><circle cx="15" cy="12" r="1.4"/><circle cx="9" cy="18" r="1.4"/><circle cx="15" cy="18" r="1.4"/></svg></button>
            <button class="mr-pick" type="button" data-menu="lunch" aria-pressed="false">
              <span class="v-dot" aria-hidden="true"></span>
              <span class="v-name">Lunch</span>
              <span class="v-time">12–4pm</span>
            </button>
          </div>
          <div class="menu-row" role="listitem" aria-current="true">
            <button class="grip" type="button" aria-label="Drag to reorder Dinner menu"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="6" r="1.4"/><circle cx="15" cy="6" r="1.4"/><circle cx="9" cy="12" r="1.4"/><circle cx="15" cy="12" r="1.4"/><circle cx="9" cy="18" r="1.4"/><circle cx="15" cy="18" r="1.4"/></svg></button>
            <button class="mr-pick" type="button" data-menu="dinner" aria-pressed="true">
              <span class="v-dot" aria-hidden="true"></span>
              <span class="v-name">Dinner</span>
              <span class="v-time">5–11pm</span>
            </button>
          </div>
        </div>
        <div class="mp-add mt-2.5">
          <button class="ghost-add" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            Add menu
          </button>
        </div>
      </aside>

      <!-- ===== RIGHT: categories ===== -->
      <section class="stagger flex flex-col gap-[clamp(14px,1.6vw,18px)] min-w-0" data-delay="3" aria-label="Dinner menu categories">

        {categories.map((cat) => (
          <section class="min-w-0 rounded-3xl border border-base-content/[.28] bg-base-200 p-[clamp(14px,1.6vw,20px)]">
            <header class="flex flex-wrap items-center gap-2.5 px-0.5 pb-3.5 pt-0.5">
              <button class="grip" type="button" aria-label={`Drag to reorder ${cat.name} category`}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="6" r="1.4"/><circle cx="15" cy="6" r="1.4"/><circle cx="9" cy="12" r="1.4"/><circle cx="15" cy="12" r="1.4"/><circle cx="9" cy="18" r="1.4"/><circle cx="15" cy="18" r="1.4"/></svg></button>
              <div class="flex min-w-0 flex-1 items-baseline gap-2.5">
                <h2 class="truncate font-display text-2xl font-bold tracking-[-0.03em]">{cat.name}</h2>
                <span class="shrink-0 text-[13px] font-semibold text-base-content/70">{cat.items.length} items</span>
              </div>
              <div class="flex shrink-0 items-center gap-2">
                <button class="rbtn" type="button" aria-label={`Edit ${cat.name} category`}><svg viewBox="0 0 24 24" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"/></svg></button>
                <button class="rbtn del" type="button" aria-label={`Delete ${cat.name} category`}><svg viewBox="0 0 24 24" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
                <button class="btn btn-ghost !h-10 !min-h-0 !px-3.5 gap-1.5 text-[13.5px] js-add" type="button" data-cat={cat.name}><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><span class="cat-add-label">Add item</span></button>
              </div>
            </header>

            <div class="items">
              {cat.items.map((d) => <DishRow d={d} />)}
            </div>
          </section>
        ))}

        <!-- Add category -->
        <div class="mt-0.5">
          <button class="ghost-add" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            Add category
          </button>
        </div>

      </section>
    </div><!-- /editor -->

  </main>

  <!-- ============ ITEM EDIT PANEL (right slide-in, NOT the app shell drawer) ============
       Ported in its closed initial state. Static in the prototype (no opener wired —
       per-row/category edit buttons are visual affordances); display:none while closed
       so the fixed off-canvas panel adds no horizontal overflow. -->
  <div class="edit-scrim" id="editScrim" hidden></div>
  <aside class="edit-panel" id="editPanel" role="dialog" aria-modal="true" aria-labelledby="editPanelTitle" aria-hidden="true">
    <header class="dr-head">
      <h2 id="editPanelTitle">Edit item</h2>
      <button class="dr-close" type="button" aria-label="Close editor">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </header>
    <form class="dr-body" onsubmit="return false">
      <div class="field">
        <label for="fName">Name</label>
        <input class="input w-full" id="fName" name="name" type="text" placeholder="e.g. Smoked short rib" autocomplete="off" />
      </div>
      <div class="field">
        <label for="fDesc">Description</label>
        <textarea class="textarea w-full" id="fDesc" name="description" placeholder="A short, appetising line — what makes it special."></textarea>
      </div>
      <div class="field">
        <label for="fPrice">Price</label>
        <div class="price-wrap">
          <span class="cur" aria-hidden="true">$</span>
          <input class="input w-full" id="fPrice" name="price" type="number" min="0" step="1" inputmode="decimal" placeholder="0" />
        </div>
      </div>
      <div class="field">
        <span class="flabel" id="upLabel">Image</span>
        <div class="upload" id="uploadZone" role="button" tabindex="0" aria-labelledby="upLabel" aria-describedby="upDesc">
          <img class="preview" id="uploadPreview" src="/img/photo-1432139555190-58524dae6a55.jpg" alt="Current dish photo preview" />
          <div class="up-text">
            <b>Drag a photo here</b>
            <span id="upDesc">or browse — JPG or PNG, square works best.</span>
            <button class="up-btn" type="button" aria-hidden="true" tabindex="-1">
              <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              Browse files
            </button>
          </div>
        </div>
      </div>
      <div class="field">
        <span class="flabel">Status</span>
        <div class="seg" role="radiogroup" aria-label="Availability in editor" id="formSeg">
          <button type="button" role="radio" data-val="available" aria-checked="true"><span class="sdot" aria-hidden="true"></span>Available</button>
          <button type="button" role="radio" data-val="soldout" aria-checked="false"><span class="sdot" aria-hidden="true"></span>Sold out</button>
          <button type="button" role="radio" data-val="unavailable" aria-checked="false"><span class="sdot" aria-hidden="true"></span>Unavailable</button>
        </div>
      </div>
      <div class="field">
        <span class="flabel">Tags</span>
        <div class="tags" role="group" aria-label="Item tags">
          <button class="tag" type="button" aria-pressed="false"><span class="tk" aria-hidden="true"></span>Popular</button>
          <button class="tag" type="button" aria-pressed="false"><span class="tk" aria-hidden="true"></span>New</button>
          <button class="tag" type="button" aria-pressed="false"><span class="tk" aria-hidden="true"></span>Chef's Special</button>
          <button class="tag" type="button" aria-pressed="false"><span class="tk" aria-hidden="true"></span>Spicy</button>
        </div>
      </div>
    </form>
    <footer class="dr-foot">
      <button class="btn btn-ghost" type="button">Cancel</button>
      <button class="btn btn-primary" type="button">Save</button>
    </footer>
  </aside>
</AppShell>

<!-- Co-located DishRow island CSS (grip / rbtn / item row / seg primitives),
     injected once here rather than per-row. See DishRow.tsx. -->
<style is:global set:html={dishRowStyles}></style>

<style is:global>
/* ============================================================
   Menu-editor page bespoke layout. Companion to the DishRow island
   (which owns the shared .grip/.rbtn/.seg row primitives). All colours
   read design-system tokens; pure-black shadow stops are the documented
   DESIGN.md §4 carve-out. --ease is the local easing alias (source :root).
   ============================================================ */
:root { --ease: cubic-bezier(0.16,1,0.3,1); }

/* ---- Two-column editor layout ---- */
.editor {
  display: grid;
  grid-template-columns: 280px minmax(0,1fr);
  gap: clamp(16px,1.8vw,22px);
  align-items: start;
}

/* ---- Menu selector rows (left panel) ---- */
.menu-list { display: flex; flex-direction: column; gap: 6px; }
.menu-row {
  display: flex; align-items: center; gap: 6px; width: 100%;
  padding: 9px 11px; min-height: 48px;
  background: transparent; border: 1px solid transparent; border-radius: 14px;
  color: var(--color-base-content); text-align: left;
  transition: background .25s var(--ease), border-color .25s var(--ease);
}
.menu-row:hover { background: color-mix(in oklch, var(--color-base-300) 45%, transparent); }
.menu-row .grip { width: 20px; height: 34px; border-radius: 8px; opacity: 0; transition: opacity .2s, color .2s; }
.menu-row:hover .grip { opacity: 1; }
.menu-row .mr-pick {
  flex: 1; min-width: 0;
  display: flex; align-items: center; gap: 10px;
  background: none; border: 0; padding: 0; color: inherit; cursor: pointer; font: inherit;
}
/* Selected menu: saffron tint + glow dot + saffron name — no side-stripe (DESIGN.md §6) */
.menu-row[aria-current="true"] {
  background: color-mix(in oklch, var(--color-secondary) 12%, transparent);
  border-color: color-mix(in oklch, var(--color-secondary) 40%, transparent);
}
.menu-row[aria-current="true"] .grip { color: var(--color-secondary); }

/* Menu row internals */
.v-dot {
  width: 7px; height: 7px; border-radius: 50%; flex: none;
  background: color-mix(in oklch, var(--color-base-content) 30%, transparent);
  transition: background .25s var(--ease), box-shadow .25s var(--ease);
}
.menu-row[aria-current="true"] .v-dot {
  background: var(--color-secondary);
  box-shadow: 0 0 10px color-mix(in oklch, var(--color-secondary) 60%, transparent);
}
.v-name {
  font-family: var(--font-display); font-weight: 600; font-size: 1.06rem; letter-spacing: -0.01em;
  color: var(--color-base-content); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.menu-row[aria-current="true"] .v-name { color: var(--color-secondary); }
.v-time {
  margin-left: auto; flex: none;
  font-size: .72rem; font-weight: 600; color: var(--color-secondary);
  background: color-mix(in oklch, var(--color-secondary) 14%, transparent);
  padding: 3px 9px; border-radius: 999px; font-variant-numeric: tabular-nums;
}

/* ---- Ghost dashed add button ---- */
.ghost-add {
  display: flex; align-items: center; justify-content: center; gap: 9px;
  width: 100%; min-height: 46px; padding: 0 16px;
  background: transparent;
  border: 1px dashed color-mix(in oklch, var(--color-base-content) 50%, transparent);
  border-radius: 14px;
  color: color-mix(in oklch, var(--color-base-content) 60%, transparent);
  font-family: var(--font-body); font-weight: 600; font-size: 13.5px;
  transition: border-color .25s var(--ease), color .25s var(--ease),
              background .25s var(--ease), transform .3s var(--ease);
}
.ghost-add:hover {
  border-color: var(--color-secondary);
  color: var(--color-base-content);
  background: color-mix(in oklch, var(--color-secondary) 6%, transparent);
  transform: translateY(-1px);
}
.ghost-add svg { width: 16px; height: 16px; stroke: currentColor; flex: none; }

/* ---- Item edit panel (right slide-in — NOT the app shell drawer) ---- */
.edit-scrim {
  position: fixed; inset: 0; z-index: 55;
  background: oklch(0.13 0.02 50 / 0.62);
  backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
  opacity: 0; visibility: hidden;
  transition: opacity .3s var(--ease), visibility .3s var(--ease);
}
.edit-scrim.show { opacity: 1; visibility: visible; }

.edit-panel {
  position: fixed; top: 0; right: 0; bottom: 0; z-index: 70;
  width: min(440px, 100vw);
  background: var(--color-base-200);
  border-left: 1px solid color-mix(in oklch, var(--color-base-content) 50%, transparent);
  box-shadow: -24px 0 60px -30px oklch(0 0 0 / 0.85);
  flex-direction: column;
  transform: translateX(100%);
  transition: transform .42s var(--ease);
  will-change: transform;
  /* Closed initial state: kept out of layout so the off-canvas panel
     cannot add horizontal overflow in this static prototype. */
  display: none;
}
.edit-panel.open { display: flex; transform: translateX(0); }

.dr-head {
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  padding: 18px 20px;
  border-bottom: 1px solid color-mix(in oklch, var(--color-base-content) 28%, transparent);
  flex: none;
}
.dr-head h2 {
  font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; letter-spacing: -0.03em;
  color: var(--color-base-content);
}
.dr-close {
  width: 44px; height: 44px; border-radius: 12px; flex: none;
  display: inline-flex; align-items: center; justify-content: center;
  background: var(--color-base-300);
  border: 1px solid color-mix(in oklch, var(--color-base-content) 28%, transparent);
  color: color-mix(in oklch, var(--color-base-content) 60%, transparent);
  transition: background .2s var(--ease), color .2s var(--ease), border-color .2s var(--ease);
}
.dr-close:hover {
  color: var(--color-base-content);
  border-color: color-mix(in oklch, var(--color-base-content) 50%, transparent);
}
.dr-close svg { width: 18px; height: 18px; stroke: currentColor; }

.dr-body { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 18px; }

/* Form field groups in the edit panel */
.field { display: flex; flex-direction: column; gap: 8px; }
.field > label, .field > .flabel {
  font-size: 13px; font-weight: 600; color: var(--color-base-content); letter-spacing: .01em;
}
.field .hint { font-size: 12px; color: color-mix(in oklch, var(--color-base-content) 60%, transparent); }

/* Input backgrounds in edit panel */
.dr-body .input, .dr-body .textarea { background: var(--color-base-100); }
/* Textarea: auto height (app.css height only targets .input/.select) */
.dr-body .textarea { height: auto !important; min-height: 92px; padding: 12px 14px; line-height: 1.5; resize: vertical; }

/* Price field: $ prefix overlay */
.price-wrap { position: relative; }
.price-wrap .cur {
  position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
  color: var(--color-secondary); font-weight: 600; font-variant-numeric: tabular-nums; pointer-events: none;
}
.price-wrap .input { padding-left: 28px; color: var(--color-secondary); font-weight: 600; font-variant-numeric: tabular-nums; }

/* Image upload zone */
.upload {
  display: flex; align-items: center; gap: 14px; padding: 14px;
  border: 1px dashed color-mix(in oklch, var(--color-base-content) 50%, transparent);
  border-radius: 16px; background: var(--color-base-100);
  transition: border-color .25s var(--ease), background .25s var(--ease);
}
.upload.drag {
  border-color: var(--color-secondary);
  background: color-mix(in oklch, var(--color-secondary) 7%, transparent);
}
.upload .preview {
  width: 64px; height: 64px; border-radius: 12px; object-fit: cover; flex: none;
  border: 1px solid color-mix(in oklch, var(--color-base-content) 28%, transparent);
}
.upload .up-text { flex: 1; min-width: 0; }
.upload .up-text b { display: block; font-size: 13.5px; color: var(--color-base-content); font-weight: 600; }
.upload .up-text span { display: block; font-size: 12px; color: color-mix(in oklch, var(--color-base-content) 60%, transparent); margin-top: 2px; }
.upload .up-btn {
  margin-top: 8px; display: inline-flex; align-items: center; gap: 7px;
  min-height: 36px; padding: 0 12px;
  background: var(--color-base-300);
  border: 1px solid color-mix(in oklch, var(--color-base-content) 50%, transparent);
  border-radius: 999px; color: var(--color-base-content); font-size: 12.5px; font-weight: 600; cursor: pointer;
}
.upload .up-btn:hover { border-color: var(--color-secondary); color: var(--color-secondary); }
.upload .up-btn svg { width: 14px; height: 14px; stroke: currentColor; }

/* Tag chips */
.tags { display: flex; flex-wrap: wrap; gap: 8px; }
.tag {
  display: inline-flex; align-items: center; gap: 7px;
  min-height: 38px; padding: 0 14px;
  background: var(--color-base-100);
  border: 1px solid color-mix(in oklch, var(--color-base-content) 50%, transparent);
  border-radius: 999px;
  color: color-mix(in oklch, var(--color-base-content) 60%, transparent);
  font-family: var(--font-body); font-weight: 600; font-size: 13px;
  transition: background .2s var(--ease), color .2s var(--ease), border-color .2s var(--ease);
}
.tag .tk { width: 7px; height: 7px; border-radius: 50%; background: currentColor; opacity: .5; }
