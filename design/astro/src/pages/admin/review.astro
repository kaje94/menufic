---
import AdminLayout from '../../layouts/AdminLayout.astro';

// Migrated from design/landing/admin/review.html (~786 lines). AdminLayout
// owns the shared Admin shell (topbar + "Admin sections" tabsbar), the
// `main h1` / `.meta h3` body-font override, and the ≤520px `main` padding
// rule — see AdminLayout.astro. Everything below is page-specific content:
// the review-queue table (row-main/detail-row expand pattern), AI
// recommendation badges, menu-preview card, AI pre-screen panel, and the
// admin compact action buttons (.admin-btn + approve/reject/send variants).
//
// BESPOKE CSS (documented per the source's own header comment, review.html
// lines 11-19): Admin is "intentionally utilitarian... near-default
// daisyUI"; that same comment calls out `.table-wrap`/`.row-main`/
// `.admin-btn`/`.count-pill` as the SAME shape admin/restaurants.html uses
// ("for cross-page consistency") — a future admin/restaurants.astro task
// will need this CSS again. Per the design/landing migration notes
// (.superpowers/sdd/progress.md, Task 13/14), this cross-page duplication
// was already flagged as a known MINOR there, not something this
// single-page task is meant to resolve (extracting a shared admin
// stylesheet/component is a bigger call than this task's scope). Kept as a
// page-scoped <style>, the same carve-out AdminLayout itself already uses
// for the shell chrome. Every declaration below reads an existing theme
// token (--color-success/error/warning/base-*, --font-body) — no new raw/
// off-brand literals were needed here (unlike AdminLayout's admin-blue
// accent, this page-specific CSS was already 100% token-driven in source).
//
// SEMANTICS (verified against source review.html:280-306): "Approve &
// publish" = tonal SUCCESS (green); "Reject…" (reveals the comment box) =
// tonal ERROR (red); "Send rejection" (the actually-committed destructive
// action) = SOLID error. The AI badges reuse success (Pass) / warning
// (Flag) tokens, matching the Two-Accent Rule (saffron reserved for
// attention elsewhere in the app; this admin surface uses warning instead).
//
// INTERACTIVITY: the source's inline <script> (row expand/collapse, reject-
// box reveal, approve/send "prototype feedback" text swap) is dropped
// entirely — matches the dead-action/closed-initial-state precedent used
// throughout this migration (e.g. menu-editor.astro's item-edit panel is
// ported closed because that's the source's pre-JS initial DOM). All three
// `.detail-row`s are ported `hidden`, exactly as source renders before its
// script runs; approve/reject/send buttons and the reject textareas are
// static affordances (no handlers wired).
//
// `<main>` keeps the source's `max-w-[1180px] mx-auto` (review.html:484).
---
<AdminLayout title="Review queue — Menufic Admin">
  <main class="px-4 pt-[18px] pb-16 max-w-[1180px] mx-auto">
    <div class="flex items-baseline gap-3 flex-wrap mb-1">
      <h1 class="text-lg font-bold m-0 -tracking-[0.01em]">Review queue</h1>
      <span class="count-pill">3 pending</span>
    </div>
    <p class="text-[12.5px] text-base-content/60 mt-0.5 mb-4">First-time publish requests awaiting approval. Oldest first. AI pre-screening shown per row; you make the final call.</p>

    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Restaurant</th>
            <th scope="col">Owner email</th>
            <th scope="col">Submitted</th>
            <th scope="col">AI recommendation</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>

          <!-- Row 1: Verde Kitchen -->
          <tr class="row-main" aria-expanded="false" aria-controls="d-verde" data-toggle>
            <td><span class="r-name"><span class="chev">&rsaquo;</span>Verde Kitchen</span></td>
            <td class="r-owner">arun@verdekitchen.com</td>
            <td class="r-time">2 hours ago</td>
            <td><span class="badge-ai badge-ai-pass">AI: Pass</span></td>
            <td class="cell-actions"><button type="button" class="admin-btn" data-review>Review</button></td>
          </tr>
          <tr class="detail-row" id="d-verde" hidden>
            <td colspan="5">
              <div class="detail-inner">
                <div class="meta">
                  <h3>Menu preview (public view)</h3>
                  <div class="preview-card">
                    <div class="preview-head">Verde Kitchen</div>
                    <div class="preview-tagline">Plant-forward bowls &amp; small plates</div>
                    <div class="preview-cat">Mains</div>
                    <div class="preview-item">
                      <div><div class="nm">Charred Broccolini Bowl</div><div class="ds">Farro, tahini, preserved lemon, dukkah</div></div>
                      <div class="pr">£13.50</div>
                    </div>
                    <div class="preview-item">
                      <div><div class="nm">Smoked Beet Tartare</div><div class="ds">Capers, shallot, rye crisp</div></div>
                      <div class="pr">£11.00</div>
                    </div>
                    <div class="preview-cat">Sides</div>
                    <div class="preview-item">
                      <div><div class="nm">Miso Roast Carrots</div><div class="ds">Sesame, chilli honey</div></div>
                      <div class="pr">£6.50</div>
                    </div>
                    <div class="preview-note">12 items across 3 categories · 1 menu</div>
                  </div>
                </div>
                <div class="meta">
                  <h3>AI pre-screen details</h3>
                  <div class="ai-line"><b>Checked for:</b></div>
                  <div class="ai-checks">
                    <span class="chk">Spam / junk</span>
                    <span class="chk">Offensive language</span>
                    <span class="chk">Placeholder text</span>
                    <span class="chk">Empty / near-empty menus</span>
                  </div>
                  <div class="ai-line"><b>Concerns flagged:</b> None</div>
                  <div class="ai-result pass">
                    <span><strong>Result: Pass</strong> — no issues detected</span>
                    <span class="conf">Confidence 0.94</span>
                  </div>
                </div>

                <div class="detail-actions">
                  <button type="button" class="admin-btn admin-btn-approve" data-approve>&#10003; Approve &amp; publish</button>
                  <button type="button" class="admin-btn admin-btn-reject" data-reject-toggle aria-expanded="false">Reject…</button>
                  <span class="hint">Approving emails the owner and publishes the menu.</span>
                </div>

                <div class="reject-box" data-reject-box hidden>
                  <label for="rej-verde">Rejection comment (sent to owner — required)</label>
                  <textarea id="rej-verde" placeholder="Explain what needs to change before this menu can be published…"></textarea>
                  <div class="reject-actions">
                    <button type="button" class="admin-btn admin-btn-send" data-send>Send rejection</button>
                    <button type="button" class="admin-btn" data-reject-cancel>Cancel</button>
                  </div>
                </div>
              </div>
            </td>
          </tr>

          <!-- Row 2: Tony's Pizzeria (FLAG) -->
          <tr class="row-main" aria-expanded="false" aria-controls="d-tony" data-toggle>
            <td><span class="r-name"><span class="chev">&rsaquo;</span>Tony's Pizzeria</span></td>
            <td class="r-owner">tony@tonyspizza.co</td>
            <td class="r-time">5 hours ago</td>
            <td>
              <span class="badge-ai badge-ai-flag">AI: Flag</span>
              <span class="flag-reason">Placeholder text detected</span>
            </td>
            <td class="cell-actions"><button type="button" class="admin-btn" data-review>Review</button></td>
          </tr>
          <tr class="detail-row" id="d-tony" hidden>
            <td colspan="5">
              <div class="detail-inner">
                <div class="meta">
                  <h3>Menu preview (public view)</h3>
                  <div class="preview-card">
                    <div class="preview-head">Tony's Pizzeria</div>
                    <div class="preview-tagline">Wood-fired Neapolitan pizza</div>
                    <div class="preview-cat">Pizza</div>
                    <div class="preview-item">
                      <div><div class="nm">Margherita</div><div class="ds">San Marzano, fior di latte, basil</div></div>
                      <div class="pr">£9.00</div>
                    </div>
                    <div class="preview-item">
                      <div><div class="nm">Diavola</div><div class="ds">Spicy salami, chilli, mozzarella</div></div>
                      <div class="pr">£12.00</div>
                    </div>
                    <div class="preview-item">
                      <div><div class="nm">Lorem ipsum pizza</div><div class="ds" style="color:var(--color-warning)">Lorem ipsum dolor sit amet description here</div></div>
                      <div class="pr">£0.00</div>
                    </div>
                    <div class="preview-note">9 items across 2 categories · 1 menu</div>
                  </div>
                </div>
                <div class="meta">
                  <h3>AI pre-screen details</h3>
                  <div class="ai-line"><b>Checked for:</b></div>
                  <div class="ai-checks">
                    <span class="chk">Spam / junk</span>
                    <span class="chk">Offensive language</span>
                    <span class="chk">Placeholder text</span>
                    <span class="chk">Empty / near-empty menus</span>
                  </div>
                  <div class="ai-line"><b>Concerns flagged:</b> Placeholder text — item "Lorem ipsum pizza" and a £0.00 price.</div>
                  <div class="ai-result flag">
                    <span><strong>Result: Flag</strong> — review before approving</span>
                    <span class="conf">Confidence 0.88</span>
                  </div>
                </div>

                <div class="detail-actions">
                  <button type="button" class="admin-btn admin-btn-approve" data-approve>&#10003; Approve &amp; publish</button>
                  <button type="button" class="admin-btn admin-btn-reject" data-reject-toggle aria-expanded="false">Reject…</button>
                  <span class="hint">Flagged: confirm placeholder content is resolved before approving.</span>
                </div>

                <div class="reject-box" data-reject-box hidden>
                  <label for="rej-tony">Rejection comment (sent to owner — required)</label>
                  <textarea id="rej-tony" placeholder="Explain what needs to change before this menu can be published…">Please replace the "Lorem ipsum pizza" placeholder item and set a real price before resubmitting.</textarea>
                  <div class="reject-actions">
                    <button type="button" class="admin-btn admin-btn-send" data-send>Send rejection</button>
                    <button type="button" class="admin-btn" data-reject-cancel>Cancel</button>
                  </div>
                </div>
              </div>
            </td>
          </tr>

          <!-- Row 3: Green Bowl -->
          <tr class="row-main" aria-expanded="false" aria-controls="d-green" data-toggle>
            <td><span class="r-name"><span class="chev">&rsaquo;</span>Green Bowl</span></td>
            <td class="r-owner">lia@greenbowl.io</td>
            <td class="r-time">1 day ago</td>
            <td><span class="badge-ai badge-ai-pass">AI: Pass</span></td>
            <td class="cell-actions"><button type="button" class="admin-btn" data-review>Review</button></td>
          </tr>
          <tr class="detail-row" id="d-green" hidden>
            <td colspan="5">
              <div class="detail-inner">
                <div class="meta">
                  <h3>Menu preview (public view)</h3>
                  <div class="preview-card">
                    <div class="preview-head">Green Bowl</div>
                    <div class="preview-tagline">Fast, fresh grain bowls</div>
                    <div class="preview-cat">Bowls</div>
                    <div class="preview-item">
                      <div><div class="nm">Teriyaki Tofu Bowl</div><div class="ds">Brown rice, edamame, pickled ginger</div></div>
                      <div class="pr">£10.50</div>
                    </div>
                    <div class="preview-item">
                      <div><div class="nm">Harissa Chickpea Bowl</div><div class="ds">Couscous, roast pepper, yoghurt</div></div>
                      <div class="pr">£9.50</div>
                    </div>
                    <div class="preview-cat">Drinks</div>
                    <div class="preview-item">
                      <div><div class="nm">Yuzu Lemonade</div><div class="ds">House-made, lightly sparkling</div></div>
                      <div class="pr">£3.50</div>
                    </div>
                    <div class="preview-note">15 items across 4 categories · 1 menu</div>
                  </div>
                </div>
                <div class="meta">
                  <h3>AI pre-screen details</h3>
                  <div class="ai-line"><b>Checked for:</b></div>
                  <div class="ai-checks">
                    <span class="chk">Spam / junk</span>
                    <span class="chk">Offensive language</span>
                    <span class="chk">Placeholder text</span>
                    <span class="chk">Empty / near-empty menus</span>
                  </div>
                  <div class="ai-line"><b>Concerns flagged:</b> None</div>
                  <div class="ai-result pass">
                    <span><strong>Result: Pass</strong> — no issues detected</span>
                    <span class="conf">Confidence 0.96</span>
                  </div>
                </div>

                <div class="detail-actions">
                  <button type="button" class="admin-btn admin-btn-approve" data-approve>&#10003; Approve &amp; publish</button>
                  <button type="button" class="admin-btn admin-btn-reject" data-reject-toggle aria-expanded="false">Reject…</button>
                  <span class="hint">Approving emails the owner and publishes the menu.</span>
                </div>

                <div class="reject-box" data-reject-box hidden>
                  <label for="rej-green">Rejection comment (sent to owner — required)</label>
                  <textarea id="rej-green" placeholder="Explain what needs to change before this menu can be published…"></textarea>
                  <div class="reject-actions">
                    <button type="button" class="admin-btn admin-btn-send" data-send>Send rejection</button>
                    <button type="button" class="admin-btn" data-reject-cancel>Cancel</button>
                  </div>
                </div>
              </div>
            </td>
          </tr>

        </tbody>
      </table>
    </div>
  </main>
</AdminLayout>

<style>
  /* ── Bespoke Admin page CSS (FLAGGED — see frontmatter note above) ────
     Ported verbatim from admin/review.html's page-specific <style> rules
     (chrome/topbar/tabsbar + the shared `main h1`/`.meta h3` font override
     + ≤520px `main` padding already live in AdminLayout.astro — not
     repeated here). Every color below is an existing theme token. */

  /* ── Page header ─────────────────────────────────────────────────── */
  /* Pending count: warning-toned (Two-Accent Rule: saffron = attention;
     these are items actually awaiting the admin's action). */
  .count-pill {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--color-warning);
    background: color-mix(in oklch, var(--color-warning) 14%, transparent);
    border: 1px solid color-mix(in oklch, var(--color-warning) 35%, transparent);
    border-radius: 999px;
    padding: 1px 9px;
  }

  /* ── Table wrapper ───────────────────────────────────────────────── */
  .table-wrap {
    min-width: 0;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid color-mix(in oklch, var(--color-base-content) 12%, transparent);
    border-radius: 6px;
    background: var(--color-base-200);
  }
  .table-wrap table {
    border-collapse: collapse;
    width: 100%;
    min-width: 720px;
    font-size: 13px;
  }
  .table-wrap thead th {
    text-align: left;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--color-base-content) 40%, transparent);
    padding: 10px 14px;
    border-bottom: 1px solid color-mix(in oklch, var(--color-base-content) 12%, transparent);
    background: var(--color-base-300);
    white-space: nowrap;
  }
  .table-wrap tbody td {
    padding: 12px 14px;
    border-bottom: 1px solid color-mix(in oklch, var(--color-base-content) 12%, transparent);
    vertical-align: middle;
  }
  .table-wrap tbody tr:last-child td {
    border-bottom: none;
  }

  /* ── Row interactions ────────────────────────────────────────────── */
  .row-main {
    cursor: pointer;
  }
  .row-main:hover {
    background: var(--color-base-300);
  }
  .row-main[aria-expanded='true'] {
    background: var(--color-base-300);
  }
  .r-name {
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .chev {
    color: color-mix(in oklch, var(--color-base-content) 38%, transparent);
    transition: transform 0.18s ease;
    display: inline-block;
  }
  .row-main[aria-expanded='true'] .chev {
    transform: rotate(90deg);
  }
  .r-owner {
    color: color-mix(in oklch, var(--color-base-content) 60%, transparent);
    font-size: 12.5px;
    word-break: break-all;
  }
  .r-time {
    color: color-mix(in oklch, var(--color-base-content) 60%, transparent);
    white-space: nowrap;
    font-size: 12.5px;
  }
  .cell-actions {
    white-space: nowrap;
  }

  /* ── AI recommendation badge (dot + label) ───────────────────────── */
  .badge-ai {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 4px;
    white-space: nowrap;
    border: 1px solid transparent;
  }
  .badge-ai::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    flex: none;
  }
  .badge-ai-pass {
    color: var(--color-success);
    background: color-mix(in oklch, var(--color-success) 14%, transparent);
    border-color: color-mix(in oklch, var(--color-success) 30%, transparent);
  }
  .badge-ai-flag {
    color: var(--color-warning);
    background: color-mix(in oklch, var(--color-warning) 14%, transparent);
    border-color: color-mix(in oklch, var(--color-warning) 30%, transparent);
  }
  .flag-reason {
    color: color-mix(in oklch, var(--color-base-content) 60%, transparent);
    font-size: 11.5px;
    display: block;
    margin-top: 3px;
  }

  /* ── Admin compact action buttons ────────────────────────────────── */
  /* Base: 36px/6px-radius, not brand 48px pills (cross-page consistency
     w/ admin/restaurants.html, per source's own header comment). */
  .admin-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 36px;
    height: 36px;
    padding: 0 12px;
    font-size: 12.5px;
    font-weight: 600;
    border-radius: 6px;
    border: 1px solid color-mix(in oklch, var(--color-base-content) 20%, transparent);
    background: var(--color-base-300);
    color: var(--color-base-content);
    cursor: pointer;
    white-space: nowrap;
    font-family: var(--font-body);
    text-decoration: none;
  }
  .admin-btn:hover {
    border-color: color-mix(in oklch, var(--color-base-content) 36%, transparent);
  }
  /* Approve & publish: tonal success (green = confirm) */
  .admin-btn-approve {
    color: var(--color-success);
    background: color-mix(in oklch, var(--color-success) 14%, transparent);
    border-color: color-mix(in oklch, var(--color-success) 30%, transparent);
  }
  .admin-btn-approve:hover {
    background: color-mix(in oklch, var(--color-success) 24%, transparent);
  }
  /* Reject… (reveals the comment box): tonal error — danger-red, distinct from tomato */
  .admin-btn-reject {
    color: var(--color-error);
    background: color-mix(in oklch, var(--color-error) 14%, transparent);
    border-color: color-mix(in oklch, var(--color-error) 30%, transparent);
  }
  .admin-btn-reject:hover {
    background: color-mix(in oklch, var(--color-error) 24%, transparent);
  }
  /* Send rejection: the actual committed destructive action — solid error */
  .admin-btn-send {
    background: var(--color-error);
    border-color: var(--color-error);
    color: var(--color-error-content);
  }
  .admin-btn-send:hover {
    background: color-mix(in oklch, var(--color-error) 88%, white);
  }

  /* ── Expandable detail row ───────────────────────────────────────── */
  .detail-row td {
    padding: 0;
    background: var(--color-base-100);
  }
  .detail-row[hidden] {
    display: none;
  }
  .detail-inner {
    padding: 18px 16px;
    border-bottom: 1px solid color-mix(in oklch, var(--color-base-content) 12%, transparent);
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 760px) {
    .detail-inner {
      grid-template-columns: 1fr 1fr;
    }
  }
  .meta {
    background: var(--color-base-200);
    border: 1px solid color-mix(in oklch, var(--color-base-content) 12%, transparent);
    border-radius: 6px;
    padding: 14px;
    min-width: 0;
  }
  .meta h3 {
    margin: 0 0 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--color-base-content) 44%, transparent);
  }

  /* ── Menu preview card ────────────────────────────────────────────── */
  .preview-card {
    background: var(--color-base-300);
    border-radius: 6px;
    padding: 12px;
    border: 1px solid color-mix(in oklch, var(--color-base-content) 12%, transparent);
  }
  .preview-head {
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 2px;
  }
  .preview-tagline {
    color: color-mix(in oklch, var(--color-base-content) 60%, transparent);
    font-size: 12.5px;
    word-break: break-all;
  }
  .preview-cat {
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--color-base-content) 44%, transparent);
    margin: 10px 0 6px;
  }
  .preview-item {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 0;
    border-bottom: 1px dashed color-mix(in oklch, var(--color-base-content) 12%, transparent);
  }
  .preview-item:last-child {
    border-bottom: none;
  }
  .preview-item .nm {
    font-weight: 500;
    font-size: 13px;
  }
  .preview-item .ds {
    color: color-mix(in oklch, var(--color-base-content) 60%, transparent);
    font-size: 12px;
    margin-top: 1px;
  }
  .preview-item .pr {
    color: var(--color-base-content);
    font-weight: 600;
    white-space: nowrap;
    font-size: 13px;
  }
  .preview-note {
    font-size: 11px;
    color: color-mix(in oklch, var(--color-base-content) 44%, transparent);
    margin-top: 8px;
  }

  /* ── AI pre-screen panel ──────────────────────────────────────────── */
  .ai-line {
    display: flex;
    gap: 8px;
    font-size: 12.5px;
    padding: 4px 0;
    color: color-mix(in oklch, var(--color-base-content) 60%, transparent);
  }
  .ai-line b {
    color: var(--color-base-content);
    font-weight: 600;
  }
  .ai-checks {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 8px 0 4px;
  }
  .chk {
    font-size: 11px;
    color: color-mix(in oklch, var(--color-base-content) 60%, transparent);
    background: var(--color-base-300);
    border: 1px solid color-mix(in oklch, var(--color-base-content) 12%, transparent);
    border-radius: 4px;
    padding: 2px 8px;
  }
  .ai-result {
    margin-top: 10px;
    padding: 10px 12px;
    border-radius: 6px;
    font-size: 12.5px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }
  .ai-result.pass {
    background: color-mix(in oklch, var(--color-success) 14%, transparent);
    border: 1px solid color-mix(in oklch, var(--color-success) 30%, transparent);
    color: var(--color-success);
  }
  .ai-result.flag {
    background: color-mix(in oklch, var(--color-warning) 14%, transparent);
    border: 1px solid color-mix(in oklch, var(--color-warning) 30%, transparent);
    color: var(--color-warning);
