<style>
  /* ── Bespoke Admin page CSS (see frontmatter note above for what moved to
     src/styles/admin.css in Task 24 vs. what's genuinely page-specific
     here). Every color below is an existing theme token. */

  /* ── Page header ──────────────────────────────────────────────────── */
  /* Total count: plain informational tone (unlike review.html's warning-
     toned "pending" count-pill — nothing here is awaiting admin action). */
  .count-pill {
    font-size: 11.5px;
    font-weight: 600;
    color: color-mix(in oklch, var(--color-base-content) 55%, transparent);
    background: var(--color-base-300);
    border: 1px solid color-mix(in oklch, var(--color-base-content) 12%, transparent);
    border-radius: 999px;
    padding: 1px 9px;
  }

  /* ── Search toolbar ──────────────────────────────────────────────── */
  .search-field {
    position: relative;
    flex: 1 1 280px;
    min-width: 0;
  }
  .search-field svg {
    position: absolute;
    left: 11px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: color-mix(in oklch, var(--color-base-content) 38%, transparent);
    pointer-events: none;
  }
  .search-field input {
    width: 100%;
    height: 42px;
    padding: 0 12px 0 34px;
    background: var(--color-base-200);
    color: var(--color-base-content);
    border: 1px solid color-mix(in oklch, var(--color-base-content) 20%, transparent);
    border-radius: 6px;
    font-family: inherit;
    font-size: 13.5px;
  }
  .search-field input::placeholder {
    color: color-mix(in oklch, var(--color-base-content) 35%, transparent);
  }

  /* ── Table wrapper (page-specific tuning only; the outer `.table-wrap`
       wrapper + `.table-wrap thead th` are byte-identical to review.html
       and now live in src/styles/admin.css) ─────────────────────────── */
  .table-wrap table {
    border-collapse: collapse;
    width: 100%;
    min-width: 880px;
    font-size: 13px;
  }
  .table-wrap tbody td {
    padding: 11px 14px;
    border-bottom: 1px solid color-mix(in oklch, var(--color-base-content) 12%, transparent);
    vertical-align: middle;
  }

  /* ── Row interactions (page-specific only; `.row-main`+chevron+`.r-name`/
       `.r-owner`/`.cell-actions` are shared — see admin.css) ─────────── */
  .mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: color-mix(in oklch, var(--color-base-content) 60%, transparent);
  }
  .r-date {
    color: color-mix(in oklch, var(--color-base-content) 60%, transparent);
    white-space: nowrap;
    font-size: 12.5px;
    font-variant-numeric: tabular-nums;
  }

  /* ── Status badge variants ───────────────────────────────────────── */
  .badge-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 4px;
    white-space: nowrap;
    border: 1px solid transparent;
  }
  .badge-status::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    flex: none;
